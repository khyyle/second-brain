# Optional startup configuration. Copy to .env if you don't already have one.
# Existing process environment variables take precedence over this file.

# Normal application defaults (no .env file is required)
# SECOND_BRAIN_VAULT=~/second-brain
# SECOND_BRAIN_DEBUG=false
# SECOND_BRAIN_PORT=8000

# For development, explicitly enable debug/docs and optionally choose a scratch vault.
# SECOND_BRAIN_DEBUG=true
# SECOND_BRAIN_VAULT=~/second-brain-dev
